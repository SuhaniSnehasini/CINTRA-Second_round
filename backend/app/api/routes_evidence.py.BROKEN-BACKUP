@router.get("/{evidence_id}/custody")
def get_evidence_custody(evidence_id: str):
    db = SessionLocal()

    try:
        evidence = (
            db.query(Evidence)
            .filter(Evidence.evidence_id == evidence_id)
            .first()
        )

        if not evidence:
            raise HTTPException(
                status_code=404,
                detail="Evidence not found.",
            )

        events = (
            db.query(CustodyEvent)
            .filter(CustodyEvent.evidence_id == evidence_id)
            .order_by(CustodyEvent.timestamp.asc())
            .all()
        )

        for event in events:
            if event.blockchain_status in {
                "PENDING",
                "NOT_RECORDED",
            }:
                synchronize_event_from_fabric(
                    db,
                    event,
                )

        db.expire_all()

        events = (
            db.query(CustodyEvent)
            .filter(CustodyEvent.evidence_id == evidence_id)
            .order_by(CustodyEvent.timestamp.asc())
            .all()
        )

        return {
            "success": True,
            "evidence_id": evidence.evidence_id,
            "case_id": evidence.case_id,
            "status": evidence.status,
            "current_custodian": evidence.current_custodian,
            "sha256": evidence.sha256,
            "filename": evidence.filename,
            "original_filename": evidence.original_filename,
            "evidence_type": evidence.evidence_type,
            "mime_type": evidence.mime_type,
            "size_bytes": evidence.size_bytes,
            "original_badge_id": evidence.original_badge_id,
            "collector_name": evidence.collector_name,
            "collector_agency": evidence.collector_agency,
            "collection_timestamp": evidence.collection_timestamp,
            "description": evidence.description,
            "registered_at": evidence.registered_at,
            "updated_at": evidence.updated_at,
            "events": [
                event_to_dict(event)
                for event in events
            ],
        }

    finally:
        db.close()


@router.post("/{evidence_id}/transfer")
def transfer_evidence(
    evidence_id: str,
    to_badge_id: str = Form(...),
    actor_badge_id: str | None = Form(None),
    reason: str | None = Form(None),
):
    db = SessionLocal()

    try:
        evidence = (
            db.query(Evidence)
            .filter(Evidence.evidence_id == evidence_id)
            .first()
        )

        if not evidence:
            raise HTTPException(
                status_code=404,
                detail="Evidence not found.",
            )

        if not to_badge_id:
            raise HTTPException(
                status_code=400,
                detail="to_badge_id is required.",
            )

        from_custodian = evidence.current_custodian

        if from_custodian == to_badge_id:
            raise HTTPException(
                status_code=400,
                detail=(
                    "Evidence is already assigned to this custodian."
                ),
            )

        registered_event = (
            db.query(CustodyEvent)
            .filter(
                CustodyEvent.evidence_id == evidence_id,
                CustodyEvent.action == "REGISTERED",
            )
            .order_by(CustodyEvent.timestamp.asc())
            .first()
        )

        if not registered_event:
            raise HTTPException(
                status_code=400,
                detail=(
                    "Original evidence registration event "
                    "not found."
                ),
            )

        now = datetime.utcnow()

        event = CustodyEvent(
            event_id=generate_event_id(),
            evidence_id=evidence_id,
            action="TRANSFER",
            actor_badge_id=actor_badge_id,
            from_custodian=from_custodian,
            to_custodian=to_badge_id,
            reason=reason or "Evidence transferred",
            file_sha256=registered_event.file_sha256,
            timestamp=now,
            blockchain_status="PENDING",
        )

        db.add(event)

        evidence.current_custodian = to_badge_id
        evidence.updated_at = now

        db.commit()

        db.refresh(event)
        db.refresh(evidence)

        try:
            fabric_result = record_event_on_fabric(event)

            update_event_from_fabric(
                event,
                fabric_result,
            )

            db.commit()
            db.refresh(event)

        except FabricServiceError as fabric_error:
            event.blockchain_status = "FAILED"

            db.commit()
            db.refresh(event)

            return {
                "success": True,
                "evidence_id": evidence_id,
                "current_custodian": evidence.current_custodian,
                "event": event_to_dict(event),
                "blockchain_status": "FAILED",
                "blockchain_error": str(fabric_error),
            }

        return {
            "success": True,
            "evidence_id": evidence_id,
            "current_custodian": evidence.current_custodian,
            "event": event_to_dict(event),
            "blockchain_status": get_blockchain_status(event),
        }

    finally:
        db.close()


