import hashlib
import os
import uuid
from datetime import datetime

from fastapi import APIRouter, File, Form, HTTPException, UploadFile
from sqlalchemy.orm import Session

from ..database import SessionLocal
from ..models import CustodyEvent, Evidence
from ..services.fabric_service import (
    FabricServiceError,
    get_fabric_history,
    record_custody_event,
)


router = APIRouter(prefix="/evidence", tags=["Evidence"])

BASE_DIR = os.path.dirname(
    os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
)
UPLOAD_DIR = os.path.join(BASE_DIR, "uploads")

os.makedirs(UPLOAD_DIR, exist_ok=True)


def generate_evidence_id() -> str:
    return f"EVD-{uuid.uuid4().hex[:12].upper()}"


def generate_event_id() -> str:
    return f"EVT-{uuid.uuid4().hex[:12].upper()}"


def get_blockchain_status(event: CustodyEvent) -> str:
    return event.blockchain_status or "NOT_RECORDED"


def update_event_from_fabric(
    event: CustodyEvent,
    fabric_result: dict,
) -> None:
    transaction_id = (
        fabric_result.get("transaction_id")
        or fabric_result.get("tx_id")
        or fabric_result.get("txId")
    )

    if not transaction_id:
        chaincode_response = fabric_result.get("chaincode_response") or {}
        transaction_id = (
            chaincode_response.get("blockchainTxId")
            or chaincode_response.get("blockchain_tx_id")
            or chaincode_response.get("transaction_id")
            or chaincode_response.get("tx_id")
        )

    event.blockchain_tx_id = transaction_id
    event.blockchain_status = (
        fabric_result.get("blockchain_status")
        or "RECORDED"
    )


def record_event_on_fabric(event: CustodyEvent) -> dict:
    return record_custody_event(
        evidence_id=event.evidence_id,
        event_id=event.event_id,
        action=event.action,
        actor_badge_id=event.actor_badge_id,
        from_custodian=event.from_custodian,
        to_custodian=event.to_custodian,
        reason=event.reason,
        file_sha256=event.file_sha256,
        timestamp=event.timestamp.isoformat() + "Z",
    )


def synchronize_event_from_fabric(
    db: Session,
    event: CustodyEvent,
) -> None:
    try:
        history = get_fabric_history(event.evidence_id)

        if not history:
            return

        matching_event = None

        for fabric_event in history:
            fabric_event_id = (
                fabric_event.get("event_id")
                or fabric_event.get("eventId")
                or fabric_event.get("id")
            )

            if fabric_event_id == event.event_id:
                matching_event = fabric_event
                break

        if matching_event:
            update_event_from_fabric(event, matching_event)
            db.commit()

    except FabricServiceError:
        db.rollback()

    except Exception:
        db.rollback()


