@router.post("/{evidence_id}/verify")
def verify_evidence_integrity(evidence_id: str):
    db = SessionLocal()

    try:
        evidence = (
            db.query(Evidence)
            .filter(Evidence.evidence_id == evidence_id)
            .first()
        )

        if not evidence:
            raise HTTPException(
                status_code=404,
                detail="Evidence not found.",
            )

        registered_event = (
            db.query(CustodyEvent)
            .filter(
                CustodyEvent.evidence_id == evidence_id,
                CustodyEvent.action == "REGISTERED",
            )
            .order_by(CustodyEvent.timestamp.asc())
            .first()
        )

        if not registered_event:
            raise HTTPException(
                status_code=400,
                detail=(
                    "Original evidence registration event "
                    "not found."
                ),
            )

        if not evidence.file_path or not os.path.exists(
            evidence.file_path
        ):
            return {
                "success": False,
                "evidence_id": evidence_id,
                "integrity_status": "FILE_NOT_FOUND",
                "integrity_verified": False,
                "registered_sha256": registered_event.file_sha256,
                "current_sha256": None,
            }

        with open(evidence.file_path, "rb") as input_file:
            current_content = input_file.read()

        current_sha256 = hashlib.sha256(
            current_content
        ).hexdigest()

        is_match = (
            current_sha256 == registered_event.file_sha256
        )

        return {
            "success": True,
            "evidence_id": evidence_id,
            "integrity_status": (
                "VERIFIED"
                if is_match
                else "TAMPERED"
            ),
            "integrity_verified": is_match,
            "registered_sha256": registered_event.file_sha256,
            "current_sha256": current_sha256,
        }

    finally:
        db.close()


@router.post("/{evidence_id}/reconcile")
def reconcile_evidence(evidence_id: str):
    db = SessionLocal()

    try:
        evidence = (
            db.query(Evidence)
            .filter(Evidence.evidence_id == evidence_id)
            .first()
        )

        if not evidence:
            raise HTTPException(
                status_code=404,
                detail="Evidence not found.",
            )

        try:
            fabric_history = get_fabric_history(
                evidence_id
            )

        except FabricServiceError as fabric_error:
            raise HTTPException(
                status_code=502,
                detail=(
                    "Unable to read Fabric custody history: "
                    f"{fabric_error}"
                ),
            )

        if not fabric_history:
            fabric_history = []

        local_events = (
            db.query(CustodyEvent)
            .filter(CustodyEvent.evidence_id == evidence_id)
            .order_by(CustodyEvent.timestamp.asc())
            .all()
        )

        synchronized_count = 0

        for event in local_events:
            for fabric_event in fabric_history:
                fabric_event_id = (
                    fabric_event.get("event_id")
                    or fabric_event.get("eventId")
                    or fabric_event.get("id")
                )

                if fabric_event_id == event.event_id:
                    update_event_from_fabric(
                        event,
                        fabric_event,
                    )

                    synchronized_count += 1
                    break

        db.commit()

        db.refresh(evidence)

        refreshed_events = (
            db.query(CustodyEvent)
            .filter(CustodyEvent.evidence_id == evidence_id)
            .order_by(CustodyEvent.timestamp.asc())
            .all()
        )

        return {
            "success": True,
            "evidence_id": evidence_id,
            "local_event_count": len(local_events),
            "fabric_event_count": len(fabric_history),
            "synchronized_count": synchronized_count,
            "evidence": evidence_to_dict(evidence),
            "events": [
                event_to_dict(event)
                for event in refreshed_events
            ],
        }

    finally:
        db.close()
