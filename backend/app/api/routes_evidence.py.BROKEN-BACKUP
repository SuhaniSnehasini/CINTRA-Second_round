        "timestamp": event.timestamp,
        "blockchain_tx_id": event.blockchain_tx_id,
        "blockchain_status": get_blockchain_status(event),
    }


def parse_collection_timestamp(
    collection_timestamp: str | None,
) -> datetime | None:
    if not collection_timestamp:
        return None

    try:
        parsed = datetime.fromisoformat(
            collection_timestamp.replace("Z", "+00:00")
        )

        if parsed.tzinfo is not None:
            parsed = parsed.replace(tzinfo=None)

        return parsed

    except ValueError:
        raise HTTPException(
            status_code=400,
            detail=(
                "Invalid collection_timestamp. "
                "Use ISO format such as 2026-09-15T10:30:00Z."
            ),
        )


@router.post("/upload")
async def upload_evidence(
    file: UploadFile = File(...),
    type: str = Form("Evidence"),
    badge_id: str | None = Form(None),
    case_id: str | None = Form(None),
    collector_name: str | None = Form(None),
    collector_agency: str | None = Form(None),
    collection_timestamp: str | None = Form(None),
    description: str | None = Form(None),
):
    db = SessionLocal()
    file_path = None

    try:
        if not file.filename:
            raise HTTPException(
                status_code=400,
                detail="A filename is required.",
            )

        content = await file.read()

        if not content:
            raise HTTPException(
                status_code=400,
                detail="Uploaded file is empty.",
            )

        file_sha256 = hashlib.sha256(content).hexdigest()

        evidence_id = generate_evidence_id()

        original_filename = file.filename

        extension = os.path.splitext(original_filename)[1]

        safe_filename = f"{evidence_id}{extension}"

        file_path = os.path.join(
            UPLOAD_DIR,
            safe_filename,
        )

        with open(file_path, "wb") as output_file:
            output_file.write(content)

        parsed_collection_timestamp = parse_collection_timestamp(
            collection_timestamp
        )

        now = datetime.utcnow()

        evidence = Evidence(
            evidence_id=evidence_id,
            case_id=case_id,
            filename=safe_filename,
            original_filename=original_filename,
            evidence_type=type,
            mime_type=file.content_type or "application/octet-stream",
            file_path=file_path,
            sha256=file_sha256,
            size_bytes=len(content),
            original_badge_id=badge_id,
            current_custodian=badge_id,
            status="ACTIVE",
            registered_at=now,
            updated_at=now,
            collector_name=collector_name,
            collector_agency=collector_agency,
            collection_timestamp=parsed_collection_timestamp,
            description=description,
        )

        db.add(evidence)
        db.flush()

        event = CustodyEvent(
            event_id=generate_event_id(),
            evidence_id=evidence.evidence_id,
            action="REGISTERED",
            actor_badge_id=badge_id,
            from_custodian=None,
            to_custodian=badge_id,
            reason="Evidence registered",
            file_sha256=file_sha256,
            timestamp=now,
            blockchain_status="PENDING",
        )

        db.add(event)

        db.commit()

        db.refresh(evidence)
        db.refresh(event)

        try:
            fabric_result = record_event_on_fabric(event)

            update_event_from_fabric(
                event,
                fabric_result,
            )

            db.commit()
            db.refresh(event)

        except FabricServiceError as fabric_error:
            event.blockchain_status = "FAILED"

            db.commit()
            db.refresh(event)

            return {
                "success": True,
                "evidence": evidence_to_dict(evidence),
                "custody_event": event_to_dict(event),
                "blockchain_status": "FAILED",
                "blockchain_error": str(fabric_error),
            }

        return {
            "success": True,
            "evidence": evidence_to_dict(evidence),
            "custody_event": event_to_dict(event),
            "blockchain_status": get_blockchain_status(event),
        }

    except HTTPException:
        db.rollback()

        if file_path and os.path.exists(file_path):
            try:
                os.remove(file_path)
            except OSError:
                pass

        raise

    except Exception as error:
        db.rollback()

        if file_path and os.path.exists(file_path):
            try:
                os.remove(file_path)
            except OSError:
                pass

        raise HTTPException(
            status_code=500,
            detail=f"Evidence upload failed: {str(error)}",
        )

    finally:
        db.close()


@router.get("/{evidence_id}")
